# Скопируйте в .env и заполните. run_all.ps1 создаёт .env сам, если его нет.
APP_SECRET=          # ключ подписи сессий gateway: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_TOKEN=      # общий токен для вызовов между сервисами (другой случайный ключ)
COOKIE_SECURE=0      # поставьте 1, когда сайт работает по HTTPS
TRUST_PROXY=0        # поставьте 1, если gateway стоит за nginx или другим прокси
